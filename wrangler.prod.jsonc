{
  // QPIO PRODUCTION — qpio.app.
  //
  // Separate file from wrangler.jsonc (which is UAT) so the two can never be
  // confused: a plain `wrangler deploy` in this directory publishes UAT and
  // cannot touch production. Production requires naming this file explicitly:
  //
  //   wrangler deploy -c wrangler.prod.jsonc      (run from main, after
  //                                                preflight --full passes)
  //
  // WHY PRODUCTION MOVED OFF GITHUB PAGES (2026-08-12, CEO): the repository is
  // going private to control and count installs and to raise the cost of
  // copying the project before the company and trade mark exist. GitHub Pages
  // does not serve private repositories without an Enterprise plan, so hosting
  // had to move first or the app would have gone dark the moment the setting
  // flipped. Cloudflare also removes the 100 GB/month soft bandwidth ceiling
  // that an image-heavy app was going to meet.
  //
  // Rollback is a DNS change: point qpio.app back at GitHub Pages. Keep that in
  // mind before deleting anything on the Pages side.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "qpio-prod",
  "compatibility_date": "2026-08-01",

  // The edge script gates the question bank against AI training crawlers.
  // Everything it does not block falls through to ASSETS unchanged.
  "main": "worker/index.js",

  // A ROUTE, not a custom domain. A custom domain demands that the existing
  // GitHub Pages A records be deleted first, which means an outage window and
  // a DNS permission wrangler's token does not hold. A route intercepts the
  // request at Cloudflare's edge BEFORE it ever reaches the Pages origin, so
  // DNS does not move at all. Zero downtime, and rollback is deleting the
  // route — after which Pages serves again, untouched.
  "routes": [
    { "pattern": "qpio.app/*", "zone_name": "qpio.app" },
    { "pattern": "www.qpio.app/*", "zone_name": "qpio.app" }
  ],

  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    // Assets are served BEFORE the worker unless this says otherwise, which is
    // why the first version of the bot gate did nothing at all.
    //
    // NARROWED 2026-08-17, and this was an outage waiting to happen rather than
    // a tidiness fix. "/src/*" routed all FIFTEEN scripts index.html loads
    // through the Worker, so one uncached page load cost sixteen invocations.
    // The free allowance is 100,000 requests a day, which that arithmetic
    // exhausts at roughly 6,250 cold loads — about 9,400 monthly readers on a
    // normal peak day. Past the ceiling requests do not get billed, they FAIL,
    // and the failure lands on the question bank itself: the app stops loading.
    //
    // The gate exists to keep the verified bank out of training corpora, so it
    // now runs on the content and not on the code. app.js, i18n.js, hooks.js,
    // discovery.js, golinks.js, country.js and the image-URL map are either
    // machinery or public Wikimedia links — nothing a crawler wants and nothing
    // worth spending an invocation to protect. That is fifteen down to eight,
    // and the ceiling roughly doubles.
    //
    // Worth saying plainly: worker/index.js gates on User-Agent, so a spoofed
    // header walks through. This is a speed bump against bulk scraping, not a
    // lock, and it should not be priced or described as one.
    "run_worker_first": [
      "/src/questions*.js",
      "/src/citypacks*.js",
      "/src/truthlab*.js",
      "/src/entities.meta.js",
      "/src/entities.fr.js",
      "/robots.txt",
      "/api/*"
    ],
    "not_found_handling": "single-page-application"
  },

  // head_sampling_rate defaults to 1.0 — one log line per invocation, 20 million
  // included per month. Left at the default alongside the broad glob above it
  // was the same multiplier applied twice. One per cent is plenty to spot a
  // pattern and cannot become a bill.
  // WHAT CLOUDFLARE ITSELF WRITES DOWN, and why this is not left at the default.
  //
  // CEO, 6 Sep 2026: "review Cloudflare observability/request logging and
  // minimise it to what has a defined operational/security purpose."
  //
  // Every Worker invocation produces an automatic log holding the request, the
  // response and the metadata around it - including the FULL URL. A door tap is
  // "/go/read/lead?u=https://bookshop.org/...", so that log line records where a
  // reader went, sitting beside the address they came from. This file carried no
  // sampling rate at all, which means the default: one hundred per cent of them.
  //
  // Invocation logs are therefore OFF. Our own console.error survives, because
  // diagnosing a broken worker is a defined operational purpose and an error we
  // wrote carries only what we chose to put in it. The sampling rate stays low
  // as a second guard rather than a first one.
  "observability": {
    "enabled": true,
    "logs": {
      "invocation_logs": false,
      "head_sampling_rate": 0.01
    }
  }
}
