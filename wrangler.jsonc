{
  // QPIO app — UAT only.
  //
  // PRODUCTION IS NOT DEPLOYED FROM HERE. qpio.app stays on GitHub Pages,
  // served from `main`. This config exists so the `uat` branch can be published
  // to uat.qpio.app for sign-off, and nothing in it can move production.
  //
  // Deployed as a Worker with static assets rather than Pages: Cloudflare now
  // routes new static projects here and Pages is in maintenance. No build step,
  // no dependency — the app is a zero-build static site and stays one.
  //
  //   wrangler deploy            (run from the uat branch)
  //
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "qpio-uat",
  "compatibility_date": "2026-08-01",

  // uat.qpio.app. custom_domain lets wrangler create the DNS record and the
  // certificate itself, so the address exists the moment the deploy finishes
  // rather than after a dashboard visit.
  "routes": [
    { "pattern": "uat.qpio.app", "custom_domain": true }
  ],

  "assets": {
    "directory": "./",
    // A missing path serves index.html — the app is a single-page shell and its
    // routes are hashes, so a deep link must not 404.
    "not_found_handling": "single-page-application"
  },

  "observability": { "enabled": true }
}
